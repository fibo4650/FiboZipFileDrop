{
    "manifest_version": 3,
    "name": "Fibo zip file drop",
    "version": "1.1.0",
    "description": "Click the F icon to slide open a folder sorting panel.",
    "permissions": ["activeTab"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {},
    "content_scripts": [
      {
        "matches": ["http://*/*", "https://*/*"],
        "js": [
          "vendor/jszip.min.js",
          "core/event-bus.js",
          "features/file-picker.js",
          "features/zip-processor.js",
          "content.js"
        ]
      }
    ]
  }